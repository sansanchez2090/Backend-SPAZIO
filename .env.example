# Configuración del proyecto
PROJECT_NAME="SPAZIO API"
VERSION="1.0.0"

# Pegue la URL que copiaste de Supabase, pero con dos pequeños ajustes:
# 1. Fíjarse que la URL coincida con la zona de tu base de datos (por ejemplo, "aws-1-us-west-2" o "aws-0-us-west-1").
# 2. Reemplazar "[YOUR-PASSWORD]" por la contraseña real que creaste para tu base de datos de Supabase.
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxx:TuContraseñaReal123@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Seguridad JWT (inventa una clave secreta larga para firmar los tokens)
SECRET_KEY=mi_super_clave_secreta_para_jwt_spazio_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Pasarela de Pagos (Wompi Sandbox)
# NOTA: Para desarrollo, usar los prefijos necesarios para indicar que son claves de Sandbox. Para producción, usar las claves reales.
WOMPI_PUBLIC_KEY:=TU_API_KEY_PUBLICA_DE_WOMPI_SANDBOX
WOMPI_PRIVATE_KEY:=TU_API_KEY_PRIVADA_DE_WOMPI_SANDBOX


# Storage de Supabase para las fotos
SUPABASE_URL=URL_de_tu_proyecto_de_supabase
SUPABASE_KEY=tu_api_key_public_o_service_role_de_supabase